<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Train Derailment with Swing Bridge</title>
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <style>
    body { background: #f9f9f9; margin: 0; }
    svg { width: 100%; height: 800px; }
    .track { stroke: #444; stroke-width: 4; }
    .car-body { fill: #555; rx: 4; ry: 4; }
    .engine { fill: #333; }
    .wheel { fill: #222; }
    .window { fill: #ccc; }
    .hazmat { fill: red; }
    .bridge { stroke: #666; stroke-width: 4; }
    .smoke { fill: #bbb; opacity: 0.2; }
    .house { fill: brown; stroke: #444; stroke-width: 1; }
  </style>
</head>
<body>
  <svg></svg>

  <script>
    const svg = d3.select("svg");
    const width = window.innerWidth;
    const carWidth = 60, carHeight = 30;
    const startY = 300;
    const startX = -900;
    const gap = 10;
    const trainLength = 12;

    const bridgeX = 375;
    const bridgeLength = 150;

    // Track
    svg.append("line")
      .attr("class", "track")
      .attr("x1", 0)
      .attr("x2", bridgeX)
      .attr("y1", startY + carHeight + 10)
      .attr("y2", startY + carHeight + 10);

    svg.append("line")
      .attr("class", "track")
      .attr("x1", bridgeX + bridgeLength)
      .attr("x2", width)
      .attr("y1", startY + carHeight + 10)
      .attr("y2", startY + carHeight + 10);

    // Bridge
    const bridgeLeft = svg.append("line")
      .attr("class", "bridge")
      .attr("x1", bridgeX)
      .attr("x2", bridgeX + bridgeLength / 2)
      .attr("y1", startY + carHeight + 10)
      .attr("y2", startY + carHeight + 10);

    const bridgeRight = svg.append("line")
      .attr("class", "bridge")
      .attr("x1", bridgeX + bridgeLength / 2)
      .attr("x2", bridgeX + bridgeLength)
      .attr("y1", startY + carHeight + 10)
      .attr("y2", startY + carHeight + 10);

    // Train cars
    const cars = d3.range(trainLength - 1).map(i => {
      const g = svg.append("g")
        .attr("transform", `translate(${startX + i * (carWidth + gap)}, ${startY})`);

      g.append("rect")
        .attr("class", "car-body")
        .attr("width", carWidth)
        .attr("height", carHeight);

      g.selectAll(".wheel")
        .data([10, 40])
        .enter().append("circle")
        .attr("class", "wheel")
        .attr("cx", d => d)
        .attr("cy", carHeight + 2)
        .attr("r", 5);

      g.selectAll(".window")
        .data([15, 35])
        .enter().append("rect")
        .attr("class", "window")
        .attr("x", d => d)
        .attr("y", 5)
        .attr("width", 10)
        .attr("height", 10);

      return g;
    });

    // Engine
    const engine = svg.append("g")
      .attr("transform", `translate(${startX + (trainLength - 1) * (carWidth + gap)}, ${startY})`);

    engine.append("rect")
      .attr("class", "car-body engine")
      .attr("width", carWidth)
      .attr("height", carHeight);

    engine.append("rect")
      .attr("x", carWidth - 15)
      .attr("y", -10)
      .attr("width", 10)
      .attr("height", 10)
      .attr("fill", "#666");

    engine.selectAll(".wheel")
      .data([10, 40])
      .enter().append("circle")
      .attr("class", "wheel")
      .attr("cx", d => d)
      .attr("cy", carHeight + 2)
      .attr("r", 5);

    const train = [...cars, engine];

    function drawHouse(x, y, group) {
  // Base
  group.append("rect")
    .attr("x", x)
    .attr("y", y)
    .attr("width", 40)
    .attr("height", 40)
    .attr("fill", "#ffcc00");

  // Roof (triangle)
  group.append("polygon")
    .attr("points", `${x},${y} ${x + 20},${y - 20} ${x + 40},${y}`)
    .attr("fill", "#cc3300");

  // Door
  group.append("rect")
    .attr("x", x + 15)
    .attr("y", y + 20)
    .attr("width", 10)
    .attr("height", 20)
    .attr("fill", "#663300");
    };

    // Smoke group
    const smokeGroup = svg.append("g").attr("opacity", 0);
    function showFog(x, y) {
      const puffs = d3.range(20);
      smokeGroup.selectAll("circle")
        .data(puffs)
        .enter().append("circle")
        .attr("class", "smoke")
        .attr("cx", () => x + Math.random() * 80 - 40)
        .attr("cy", () => y + Math.random() * 30 - 10)
        .attr("r", () => 20 + Math.random() * 30)
        .transition()
        .duration(3000)
        .attr("cy", d => y - 40 + Math.random() * 20)
        .attr("opacity", 0.05);

      smokeGroup.transition().duration(500).attr("opacity", 1);
    }

    // Splash effect
    function createSplash(x, y) {
      const splashGroup = svg.append("g");
      d3.range(10).forEach(i => {
        splashGroup.append("circle")
          .attr("cx", x + Math.random() * 60 - 30)
          .attr("cy", y + Math.random() * 10)
          .attr("r", 2 + Math.random() * 3)
          .attr("fill", "#66ccff")
          .attr("opacity", 0.7)
          .transition().duration(1000)
          .attr("cy", y - 20 - Math.random() * 10)
          .attr("r", 0.5).attr("opacity", 0);
      });
      splashGroup.append("rect")
        .attr("x", x - 10).attr("y", y)
        .attr("width", 20).attr("height", 5)
        .attr("fill", "#996633")
        .attr("opacity", 0.8)
        .transition().duration(2000)
        .attr("y", y + 10).attr("opacity", 0);
    }

    // Move train
    train.forEach((g, i) => {
      const finalX = 100 + i * (carWidth + gap);
      g.transition()
        .duration(7000)
        .attr("transform", `translate(${finalX}, ${startY})`)
        .delay(500);
    });

    // Bridge break
    train.forEach((g, i) => {
      if (i === train.length - 1) {
        bridgeLeft.transition()
          .duration(700)
          .attr("transform", `rotate(35, ${bridgeX + bridgeLength / 4}, ${startY + carHeight + 10})`)
          .delay(6200);

        bridgeRight.transition()
          .duration(700)
          .attr("transform", `rotate(-35, ${bridgeX + 3 * bridgeLength / 4}, ${startY + carHeight + 10})`)
          .delay(6200)
          .on("end", () => {
            bridgeLeft.transition().duration(1000)
              .attr("transform", `rotate(90, ${bridgeX + bridgeLength / 4}, ${startY + carHeight + 10})`)
              .attr("opacity", 0);
            bridgeRight.transition().duration(1000)
              .attr("transform", `rotate(-90, ${bridgeX + 3 * bridgeLength / 4}, ${startY + carHeight + 10})`)
              .attr("opacity", 0);
            createSplash(bridgeX + bridgeLength / 2, startY + carHeight + 20);
          });
      }
    });

    // Hazmat fall + fog + global downward shift + house entry
    const hazmat1 = train.slice(-8, -7);
    hazmat1.forEach((car, j) => {
      car.transition().delay(6700).duration(1000)
        .attr("transform", `translate(${-160 + (trainLength - 4 + j) * (carWidth + gap)}, ${startY + 50})`)
        .select(".car-body").attr("class", "car-body hazmat");
    });

      // Create houses
        const houseGroup = svg.append("g");
        const g = houseGroup.append("g")
          .attr("transform", `translate(0, ${houseStartY})`);
        drawHouse(x, 0, g); // draw at relative y = 0 inside group


        const houses = d3.range(3).map((i) => {
          const x = 700 + i * 70;
          const g = houseGroup.append("g")
            .attr("transform", `translate(${x}, ${houseStartY})`);
          drawHouse(0, 0, g); // draw at relative coordinates inside group
          return g;
});
    
    const hazmat2 = train.slice(-7, -6);
    hazmat2.forEach((car, j) => {
      car.transition().delay(6700).duration(1000)
        .attr("transform", `translate(${-70 + (trainLength - 4.5 + j) * (carWidth + gap)}, ${startY + 50})`)
        .select(".car-body").attr("class", "car-body hazmat");

      setTimeout(() => {
        showFog(450 + j * (carWidth + gap) + 30, startY + 20);

        setTimeout(() => {
          svg.selectAll("*")
            .transition().duration(1500)
            .attr("transform", (d, i, nodes) => {
              const current = d3.select(nodes[i]).attr("transform");
              if (current && current.includes("translate")) {
                const match = current.match(/translate\(([^,]+),([^,]+)\)/);
                if (match) {
                  const newY = parseFloat(match[2]) + 80;
                  return `translate(${parseFloat(match[1])}, ${newY})`;
                }
              }
              return `translate(0, 50)`;
            });

          svg.selectAll(".track")
            .transition().duration(1500)
            .attr("y1", startY + carHeight + 10 + 130)
            .attr("y2", startY + carHeight + 10 + 130);
          });


          // Fog over houses
          setTimeout(() => {
            showFog(550, startY - 20);
          }, 1500);

        }, 3000);
      }, 7000);
    });
  </script>
</body>
</html>
